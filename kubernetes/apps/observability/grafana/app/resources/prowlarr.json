{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["prowlarr", "media", "indexers"],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(prowlarr_indexer_queries_total, indexer)",
        "hide": 0,
        "includeAll": true,
        "label": "Indexer",
        "multi": true,
        "name": "indexer",
        "options": [],
        "query": {
          "query": "label_values(prowlarr_indexer_queries_total, indexer)",
          "refId": "prometheus-indexer"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Media / Prowlarr / Indexers",
  "uid": "prowlarr-indexers",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Indexers enabled / configured",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(prowlarr_indexer_enabled_total)",
          "refId": "A",
          "legendFormat": "enabled"
        },
        {
          "expr": "sum(prowlarr_indexer_total)",
          "refId": "B",
          "legendFormat": "configured"
        }
      ],
      "description": "Enabled indexers against everything Prowlarr has configured — a falling 'enabled' is a disabled or failing indexer."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Queries (cumulative)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(prowlarr_indexer_queries_total{indexer=~\"$indexer\"})",
          "refId": "A",
          "legendFormat": "queries"
        }
      ],
      "description": "Search/API queries Prowlarr answered, summed over indexers. Cumulative since the exporter (re-)seeded itself from Prowlarr history — use the per-second panels for activity."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Grabs (cumulative)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(prowlarr_indexer_grabs_total{indexer=~\"$indexer\"})",
          "refId": "A",
          "legendFormat": "grabs"
        }
      ],
      "description": "Releases handed to a download client. Cumulative, same seeding rule as queries."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed query share",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * sum(prowlarr_indexer_failed_queries_total{indexer=~\"$indexer\"}) / clamp_min(sum(prowlarr_indexer_queries_total{indexer=~\"$indexer\"}), 1)",
          "refId": "A",
          "legendFormat": "failures"
        }
      ],
      "description": "Share of all queries that failed, over the cumulative counters. A single noisy indexer disappears in this ratio — see the per-indexer panel."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queries/s by indexer",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (indexer) (rate(prowlarr_indexer_queries_total{indexer=~\"$indexer\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{indexer}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Grabs/s by indexer",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (indexer) (rate(prowlarr_indexer_grabs_total{indexer=~\"$indexer\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{indexer}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Average response time by indexer",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max by (indexer) (prowlarr_indexer_average_response_time_ms{indexer=~\"$indexer\"})",
          "refId": "A",
          "legendFormat": "{{indexer}}"
        }
      ],
      "description": "Prowlarr's own average response time per indexer. Slow here plus failures in the panel next to it is how a degraded indexer shows up before searches start timing out."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Failed queries/s by indexer",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (indexer) (rate(prowlarr_indexer_failed_queries_total{indexer=~\"$indexer\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{indexer}}"
        },
        {
          "expr": "sum by (indexer) (rate(prowlarr_indexer_failed_rss_queries_total{indexer=~\"$indexer\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "{{indexer}} rss"
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Failure share by indexer",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      },
      "targets": [
        {
          "expr": "100 * sum by (indexer) (prowlarr_indexer_failed_queries_total{indexer=~\"$indexer\"}) / clamp_min(sum by (indexer) (prowlarr_indexer_queries_total{indexer=~\"$indexer\"}), 1)",
          "refId": "A",
          "legendFormat": "{{indexer}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Health issues / system status",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(prowlarr_system_health_issues)",
          "refId": "A",
          "legendFormat": "issues"
        },
        {
          "expr": "max(prowlarr_system_status)",
          "refId": "B",
          "legendFormat": "status"
        }
      ],
      "description": "Prowlarr's own health check list (indexer unavailable, failing to reach a client, ...) and whether its API answers at all."
    },
    {
      "id": 11,
      "type": "piechart",
      "title": "Queries by user agent (cumulative)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": ["value", "percent"]
        },
        "pieType": "donut",
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "sum by (user_agent) (prowlarr_user_agent_queries_total)",
          "refId": "A",
          "legendFormat": "{{user_agent}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Exporter scrape duration / collector errors",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "prowlarr_scrape_duration_seconds",
          "refId": "A",
          "legendFormat": "scrape duration"
        }
      ],
      "description": "How long exportarr's API walk takes. Rising duration means Prowlarr itself is slow, not the scrape. A failed collector reports prowlarr_collector_error instead of failing the scrape."
    },
    {
      "id": 13,
      "type": "stat",
      "title": "History items (cumulative)",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "prowlarr_history_total",
          "refId": "A",
          "legendFormat": "history"
        }
      ],
      "description": "Entries in Prowlarr's history table — grabs and queries it recorded."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "RSS queries/s by indexer",
      "datasource": "${DS_PROMETHEUS}",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (indexer) (rate(prowlarr_indexer_rss_queries_total{indexer=~\"$indexer\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{indexer}}"
        }
      ],
      "description": "RSS sync polls per indexer. Constant polling with zero grabs is usually an indexer returning results the *arrs reject."
    }
  ]
}
